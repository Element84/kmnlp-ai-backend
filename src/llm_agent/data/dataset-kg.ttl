  schema:description "Quality flag for missing data" ;
  schema:name "fill_missing_qc" ;
  schema:alternateName "cdr_heatflux_fill_missing_qc" ;
  schema:propertyID qb:measure ;

  rdfs:label "fill_missing_qc" ;
  rdfs:comment "A custom variable indicating the reason for missing values.\n 0=observation, 1=unused, 2=snow or ice contamination, 3=over land, 4=over lake, 5=high wind speed, 6=fluxes unresolved" ;

  qudt:hasUnit unit:UNITLESS .

:dsd_cdr_heatflux_fill_missing_qc a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :cdr_heatflux_fill_missing_qc] .

############################
# Properites in CMORPH CDR #
############################
:CMORPHCDRDataset a dcat:Dataset, schema:Dataset, qb:DataSet ;
  schema:name "NOAA Climate Data Record (CDR) of CPC Morphing Technique (CMORPH) High-Resolution Global Precipitation Estimates" ;
  schema:description "The CMORPH CDR is a reprocessed and bias-corrected global precipitation product created on an 8kmx8km grid over the globe (60S-60N) and in a 30-minute temporal resolution for an 18-year period from January 1998 to the present. First, the purely satellite based CMORPH precipitation estimates (raw CMORPH) are reprocessed. The integration algorithm is fixed and the input Level 2 passive microwave (PMW) retrievals of instantaneous precipitation rates are from identical versions throughout the entire data period. Bias correction is then performed for the raw CMORPH through probability density function (PDF) matching against the CPC daily gauge analysis over land and through adjustment against the Global Precipitation Climatology Program (GPCP) pentad merged analysis of precipitation over ocean. The reprocessed, bias-corrected CMORPH exhibits improved performance in representing the magnitude, spatial distribution patterns and temporal variations of precipitation over the global domain from 60S to 60N. Bias in the CMORPH satellite precipitation estimates is almost completely removed over land during warm seasons (May – September), while during co seasons (October - April) CMORPH tends to under-estimate the precipitation due to the less-than-desirable performance of the current generation PMW retrievals in detecting and quantifying snowfall and cold season rainfall. Details of the CMORPH CDR may be found in Xie et al. (2017)." ;
  schema:contentURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/noaa-cdr-precip-cmorph-pds/daily/zarr_reference_final.json> ;
  schema:sameAs <https://www.ncei.noaa.gov/access/metadata/landing-page/bin/iso?id=gov.noaa.ncdc:C00948> ;
  schema:version "1" ;
  schema:isAccessibleForFree true ;
  schema:keywords :gcmd_precipitation_amount, :ecv_precipitation ;
  schema:identifier "doi:10.25921/w9va-q159" ;

  schema:variableMeasured :lat ;
  schema:variableMeasured :lon ;
  schema:variableMeasured :time ;
  schema:variableMeasured :lwe_precipitation_rate ;

  dcterms:title "NOAA Climate Data Record (CDR) of CPC Morphing Technique (CMORPH) High-Resolution Global Precipitation Estimates" ;
  dcterms:description "The CMORPH CDR is a reprocessed and bias-corrected global precipitation product created on an 8kmx8km grid over the globe (60S-60N) and in a 30-minute temporal resolution for an 18-year period from January 1998 to the present. First, the purely satellite based CMORPH precipitation estimates (raw CMORPH) are reprocessed. The integration algorithm is fixed and the input Level 2 passive microwave (PMW) retrievals of instantaneous precipitation rates are from identical versions throughout the entire data period. Bias correction is then performed for the raw CMORPH through probability density function (PDF) matching against the CPC daily gauge analysis over land and through adjustment against the Global Precipitation Climatology Program (GPCP) pentad merged analysis of precipitation over ocean. The reprocessed, bias-corrected CMORPH exhibits improved performance in representing the magnitude, spatial distribution patterns and temporal variations of precipitation over the global domain from 60S to 60N. Bias in the CMORPH satellite precipitation estimates is almost completely removed over land during warm seasons (May – September), while during co seasons (October - April) CMORPH tends to under-estimate the precipitation due to the less-than-desirable performance of the current generation PMW retrievals in detecting and quantifying snowfall and cold season rainfall. Details of the CMORPH CDR may be found in Xie et al. (2017)." ;

  qb:structure :dsd_lwe_precipitation_rate ;


  rdfs:label "NOAA Climate Data Record (CDR) of CPC Morphing Technique (CMORPH) High-Resolution Global Precipitation Estimates" ;
  rdfs:comment "The CMORPH CDR is a reprocessed and bias-corrected global precipitation product created on an 8kmx8km grid over the globe (60S-60N) and in a 30-minute temporal resolution for an 18-year period from January 1998 to the present. First, the purely satellite based CMORPH precipitation estimates (raw CMORPH) are reprocessed. The integration algorithm is fixed and the input Level 2 passive microwave (PMW) retrievals of instantaneous precipitation rates are from identical versions throughout the entire data period. Bias correction is then performed for the raw CMORPH through probability density function (PDF) matching against the CPC daily gauge analysis over land and through adjustment against the Global Precipitation Climatology Program (GPCP) pentad merged analysis of precipitation over ocean. The reprocessed, bias-corrected CMORPH exhibits improved performance in representing the magnitude, spatial distribution patterns and temporal variations of precipitation over the global domain from 60S to 60N. Bias in the CMORPH satellite precipitation estimates is almost completely removed over land during warm seasons (May – September), while during co seasons (October - April) CMORPH tends to under-estimate the precipitation due to the less-than-desirable performance of the current generation PMW retrievals in detecting and quantifying snowfall and cold season rainfall. Details of the CMORPH CDR may be found in Xie et al. (2017)." ;

  dcat:distribution
    [a dcat:Distribution ;
    dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/noaa-cdr-precip-cmorph-pds/daily/zarr_reference_final.json> ;
    dcat:mediaType "application/zarr"] ;
  dcat:temporalResolution "P1D"^^xsd:duration ;
  dcat:startDate "1988-01-01T01:30:00Z"^^xsd:dateTime ;
  dcat:endDate "2021-08-31T22:30:00Z"^^xsd:dateTime .

:lwe_precipitation_rate a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "NOAA Climate Data Record (CDR) of CPC Morphing Technique (CMORPH) High Resolution Global Precipitation Estimates";
  schema:name "lwe_precipitation_rate" ;
  schema:alternateName "cmorph" ;
  schema:unitText "mm/day" ;
