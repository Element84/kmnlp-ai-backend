@base <http://kmnlp-demo.noaa.gov/> .

# Create prefixes for the referenced ontologies.
# This allows us to not need to repeatedly type the URL roots.
@prefix : <http://kmnlp-demo.noaa.gov/> .
@prefix cf: <http://cfconventions.org/Data/cf-standard-names/current/build/cf-standard-name-table.xml#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix qb:  <http://purl.org/linked-data/cube#> .
@prefix qudt:  <http://qudt.org/3.1.1/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix unit:  <http://qudt.org/3.1.1/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Explanation of syntax:
#   * Each record in the graph store is a subject-predicate-object triple.
#       (Think subject-verb group-object from grammar class.)
#   * A triple can be expressed like:
#       `subject predicate object .`
#   * Each "part of speech" must be a full Internationalized Resource Identifier (IRI).
#       For IRI, think Universal Resource Identifier (URI) with more allowed characters.
#   * Prefixes are used for legibility.
#   * A convenience syntax is available when multiple statements in a row have the same subject.
#       e.g.
#           developer writes code .
#           developer uses textEditor .
#       can be re-written as
#           developer writes code ;
#              uses textEditor .

