#####################
# Common Dimensions #
#####################
:lat a schema:PropertyValue, qb:DimensionProperty ;
  schema:name "lat" ;
  schema:alternateName "latitude" ;
  schema:unitText "decimal degree" ;
  schema:propertyID qb:measureDimension ;

  rdfs:label "latitude" ;
  cf:standard_name "latitude" ;
  qudt:hasUnit unit:DEG .

:lon a schema:PropertyValue, qb:DimensionProperty ;
  schema:name "lon" ;
  schema:alternateName "longitude" ;
  schema:unitText "decimal degree" ;
  schema:propertyID qb:measureDimension ;

  rdfs:label "longitude" ;
  cf:standard_name "longitude" ;
  qudt:hasUnit unit:DEG .

:time a schema:PropertyValue, qb:DimensionProperty ;
  schema:name "time" ;
  schema:alternateName "datetime" ;
  schema:propertyID qb:measureDimension ;

  rdfs:label "time" ;
  cf:standard_name "time" .

##################################
# Properties for CRW SST dataset #
##################################
:CRWSSTDataset a dcat:Dataset, schema:Dataset, qb:DataSet ;
  schema:name "NOAA Coral Reef Watch Daily Global 5km Satellite Sea Surface Temperature (CoralTemp)" ;
  schema:description "This product is designed to improve on and replace the use of AVHRR Pathfinder SST for use within the Coral Reef Watch Program." ;
  schema:contentURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/crw/5km/v3.1/nc/v1.0/daily/sst/zarr_reference.json> ;
  schema:sameAs <https://coralreefwatch.noaa.gov/product/5km/index_5km_sst.php> ;
  schema:version "3.1" ;
  schema:isAccessibleForFree true ;
  schema:keywords :gcmd_sea_surface_temperature, :gcmd_water_temperature, :gcmd_thermal_infrared ;
  schema:variableMeasured :lat ;
  schema:variableMeasured :lon ;
  schema:variableMeasured :time ;
  schema:variableMeasured :analysed_sst ;
  schema:variableMeasured :sea_ice_fraction ;

  dcterms:title "NOAA Coral Reef Watch Daily Global 5km Satellite Sea Surface Temperature (CoralTemp)" ;
  dcterms:description "This product is designed to improve on and replace the use of AVHRR Pathfinder SST for use within the Coral Reef Watch Program." ;

  qb:structure :dsd_analysed_sst, :dsd_sea_ice_fraction ;

  rdfs:label "NOAA Coral Reef Watch Daily Global 5km Satellite Sea Surface Temperature (CoralTemp)" ;
  rdfs:comment "This product is designed to improve on and replace the use of AVHRR Pathfinder SST for use within the Coral Reef Watch Program." ;

  dcat:distribution
    [a dcat:Distribution ;
    dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/crw/5km/v3.1/nc/v1.0/daily/sst/zarr_reference.json> ;
    dcat:mediaType "application/zarr"] ;

  dcat:temporalResolution "P1D"^^xsd:duration ;
  dcat:startDate "2020-01-01T00:00:00Z"^^xsd:dateTime ;
  dcat:endDate "2024-11-30T12:00:00Z"^^xsd:dateTime .

# Variables
:analysed_sst a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "analysed sea surface temperature" ; # copied from long_name
  schema:name "analysed_sst" ; # the name of the column
  schema:alternateName "sea_surface_temperature" ; # copied from standard_name
  schema:unitText "degrees_Celsius" ; # copied from units
  schema:propertyID qb:measure ;

  rdfs:label "analysed_sst" ;

  cf:standard_name "sea_surface_temperature" ;
  cf:long_name "analysed sea surface temperature" ;

  qudt:hasUnit unit:DEG_C .

:dsd_analysed_sst a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :analysed_sst] .

:sea_ice_fraction a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "Sea Ice Fraction" ; # copied from long_name
  schema:name "sea_ice_fraction" ; # the name of the column
  schema:alternateName "sea_ice_area_fraction" ; # copied from standard_name
  schema:unitText "1" ; # copied from units
  schema:propertyID qb:measure ;

  rdfs:label "sea_ice_fraction" ;
  rdfs:comment "0 is 0% ice, 1 is 100% ice" ;

  cf:standard_name "sea_ice_area_fraction" ;
  cf:long_name "Sea Ice Fraction" ;

  qudt:hasUnit unit:UNITLESS .

:dsd_sea_ice_fraction a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :sea_ice_fraction] .

###################################################
# Properties for Climate Data Record Atmo dataset #
###################################################
:CDRAtmoDataset a dcat:Dataset, schema:Dataset, qb:DataSet;
  schema:name "NOAA Climate Data Record of Ocean Near-Surface Properties" ;
  schema:description "This dataset provides a high quality Climate Data Record (CDR) of ocean near-surface properties that can be used for any analysis of the latent and sensible heat fluxes and the associated surface parameters from synoptic scale through climate variability." ;
  schema:contentURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/noaa-cdr-ocean-nearsurface-atmos-profiles-pds/daily/zarr_reference_final.json> ;
  schema:sameAs <https://www.ncei.noaa.gov/access/metadata/landing-page/bin/iso?id=gov.noaa.ncdc:C00974> ;
  schema:version "2" ;
  schema:isAccessibleForFree true ;
  schema:keywords :gcmd_surface_winds, :gcmd_ocean_heat_budget_evaporation, :gmcd_heat_flux, :gcmd_sea_surface_temperature, :gcmd_air_temperature, :gcmd_boundary_layer_temperature, :gcmd_skin_temperature, :gcmd_surface_temperature, :gcmd_water_processes_evaporation, :gcmd_humidity, :gcmd_water_vapor, :ecv_sea_surface_temperature, :ecv_air_temperature, :ecv_wind_speed_and_direction, :ecv_water_vapour ;
  schema:identifier "doi:10.7289/V55T3HH0" ;

  schema:variableMeasured :lat ;
  schema:variableMeasured :lon ;
  schema:variableMeasured :time ;
  schema:variableMeasured :air_temperature ;
  schema:variableMeasured :specific_humidity ;
  schema:variableMeasured :wind_speed ;
  schema:variableMeasured :cdr_atmo_fill_missing_qc ;

  dcterms:title "NOAA Climate Data Record of Ocean Near-Surface Properties" ;
  dcterms:description "This dataset provides a high quality Climate Data Record (CDR) of ocean near-surface properties that can be used for any analysis of the latent and sensible heat fluxes and the associated surface parameters from synoptic scale through climate variability." ;
  qb:structure :dsd_air_temperature, :dsd_specific_humidity, :dsd_wind_speed, :dsd_cdr_atmo_fill_missing_qc ;

  rdfs:label "NOAA Climate Data Record of Ocean Near-Surface Properties" ;
  rdfs:comment "This dataset provides a high quality Climate Data Record (CDR) of ocean near-surface properties that can be used for any analysis of the latent and sensible heat fluxes and the associated surface parameters from synoptic scale through climate variability." ;

  dcat:distribution
    [a dcat:Distribution ;
    dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/noaa-cdr-ocean-nearsurface-atmos-profiles-pds/daily/zarr_reference_final.json> ;
    dcat:mediaType "application/zarr"] ;

  dcat:temporalResolution "PT3H"^^xsd:duration ;
  dcat:startDate "1988-01-01T01:30:00Z"^^xsd:dateTime ;
  dcat:endDate "2021-08-31T22:30:00Z"^^xsd:dateTime .

# Variables
:air_temperature a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "NOAA CDR of near-surface air temperature" ; # copied from long_name
  schema:name "air_temperature" ; # the name of the column
  schema:alternateName "air_temperature" ; # copied from standard_name
  schema:unitText "degree_Celsius" ; # copied from units
  schema:propertyID qb:measure ;

  rdfs:label "air_temperature" ;

  qudt:hasUnit unit:DEG_C .

:dsd_air_temperature a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :air_temperature] .

:specific_humidity a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "NOAA FCDR of near-surface specific humidity" ; # copied from long_name
  schema:name "specific_humidity" ; # the name of the column
  schema:alternateName "specific_humidity" ; # copied from standard_name
  schema:unitText "g kg-1" ; # copied from units
  schema:propertyID qb:measure ;

  rdfs:label "specific_humidity" ;

  qudt:hasUnit unit:GM-PER-KiloGM .

:dsd_specific_humidity a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :specific_humidity] .

:wind_speed a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "NOAA FCDR of near-surface wind speed" ; # copied from long_name
  schema:name "wind_speed" ; # the name of the column
  schema:alternateName "wind_speed" ; # copied from standard_name
  schema:unitText "m s-1" ; # copied from units
  schema:propertyID qb:measure ;

  rdfs:label "wind_speed" ;

  qudt:hasUnit unit:M-PER-SEC .

:dsd_wind_speed a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :wind_speed] .

:cdr_atmo_fill_missing_qc a schema:PropertyValue, qb:MeasureProperty ;
  schema:description "Quality flag for missing data" ; # copied from long_name
  schema:name "fill_missing_qc" ; # the name of the column
  schema:alternateName "The reason values are missing" ;
  schema:propertyID qb:measure ;

  rdfs:label "fill_missing_qc" ;
  rdfs:comment "0=observation, 1=model-based interpolation, 2=snow or ice contamination, 3=over land, 4=over lake, 5=interpolation failed" ;

  qudt:hasUnit unit:UNITLESS .

:dsd_cdr_atmo_fill_missing_qc a qb:DataStructureDefinition ;
  qb:component
    [qb:dimension :lat] ,
    [qb:dimension :lon] ,
    [qb:dimension :time] ,
    [qb:measure :cdr_atmo_fill_missing_qc] .

