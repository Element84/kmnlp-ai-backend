:crw_daily_5km a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "NOAA Coral Reef Watch Daily Global 5km Satellite Sea Surface Temperature (CoralTemp)" ;
    dcterms:description "CoralTemp is derived from three different but related 5km daily gap-free SST data sets and provides an internally consistent SST product that stretches from 1985 to present: OSTIA Sea Surface Temperature Reanalysis (1985-2002), Geo-Polar Blended Night-only Sea Surface Temperature Reanalysis (2002-2016), Geo-Polar Blended Night-only Sea Surface Temperature Near Real-Time (2017 to present)." ;
    dcterms:title "NOAA Coral Reef Watch Daily Global 5km Satellite Sea Surface Temperature (CoralTemp)" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ qb:dimension :longitude ],
                [ qb:measure :sea_surface_temperature_crw_daily_5km ],
                [ qb:dimension :latitude ],
                [ qb:dimension :time ] ],
        [ a qb:DataStructureDefinition ;
            qb:component [ qb:dimension :latitude ],
                [ qb:dimension :time ],
                [ qb:measure :sea_ice_area_fraction_crw_daily_5km ],
                [ qb:dimension :longitude ] ] ;
    rdfs:comment "CoralTemp is derived from three different but related 5km daily gap-free SST data sets and provides an internally consistent SST product that stretches from 1985 to present: OSTIA Sea Surface Temperature Reanalysis (1985-2002), Geo-Polar Blended Night-only Sea Surface Temperature Reanalysis (2002-2016), Geo-Polar Blended Night-only Sea Surface Temperature Near Real-Time (2017 to present)." ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/crw/daily_5km/zarr_reference_final.json> ;
            dcat:mediaType "application/zarr" ] ;
    dcat:endDate "2024-12-01T00:00:00+00:00"^^xsd:dateTime ;
    dcat:startDate "2020-01-01T00:00:00+00:00"^^xsd:dateTime ;
    dcat:temporalResolution "P1D"^^xsd:duration ;
    schema:contentUrl <s3://data-c6c22a2e42294c11b52ee7f0c792c071/crw/daily_5km/zarr_reference_final.json> ;
    schema:description "CoralTemp is derived from three different but related 5km daily gap-free SST data sets and provides an internally consistent SST product that stretches from 1985 to present: OSTIA Sea Surface Temperature Reanalysis (1985-2002), Geo-Polar Blended Night-only Sea Surface Temperature Reanalysis (2002-2016), Geo-Polar Blended Night-only Sea Surface Temperature Near Real-Time (2017 to present)." ;
    schema:isAccessibleForFree true ;
    schema:keywords "Oceans > Ocean Temperature > Sea Surface Temperature",
        "Oceans > Ocean Temperature > Water Temperature",
        "Spectral/Engineering > Infrared Wavelengths > Thermal Infrared" ;
    schema:name "NOAA Coral Reef Watch Daily Global 5km Satellite Sea Surface Temperature (CoralTemp)" ;
    schema:variableMeasured :latitude,
        :longitude,
        :sea_ice_area_fraction_crw_daily_5km,
        :sea_surface_temperature_crw_daily_5km,
        :time ;
    schema:version "2" .

:noaa-cdr-aerosol-optical-thickness-pds_daily a qb:DataSet,
        dcat:Dataset,
        schema:Dataset ;
    rdfs:label "Daily AVHRR Aerosol Optical Thickness over Global Oceans, Version 4.0" ;
    dcterms:description "The product is the aerosol optical thickness (AOT) at 0.65 micron, which is retrieved from NOAA PATMOS-x level-2B orbital radinace and cloud CDR products. The retrieval is performed for selected spatial(0.1 by 0.1 degree) and temporal (1 time per day per satellite) resolution in cloud free condition during daytime. The final product is daily avergaed from all satellite retrivals and in a 0.1 by 0.1 degree equal angle grid (total 1800x3600 grids over the globe). Due to the relatively large uncertainties associated with surface reflectance over water glint area and land surface as well as limited AVHRR retrieval channels, the current algorithm only performs retrieval over none-glint water surface (specifically at the anti-solar side of the orbit and viewing angle is larger than 40 degree away from the specular ray). The final CDR AOT products include daily and monthly products" ;
    dcterms:title "Daily AVHRR Aerosol Optical Thickness over Global Oceans, Version 4.0" ;
    qb:structure [ a qb:DataStructureDefinition ;
            qb:component [ qb:dimension :latitude ],
                [ qb:dimension :longitude ],
                [ qb:dimension :time ],
                [ qb:measure :atmosphere_optical_thickness_due_to_ambient_aerosol_noaa-cdr-aerosol-optical-thickness-pds_daily ] ] ;
    rdfs:comment "The product is the aerosol optical thickness (AOT) at 0.65 micron, which is retrieved from NOAA PATMOS-x level-2B orbital radinace and cloud CDR products. The retrieval is performed for selected spatial(0.1 by 0.1 degree) and temporal (1 time per day per satellite) resolution in cloud free condition during daytime. The final product is daily avergaed from all satellite retrivals and in a 0.1 by 0.1 degree equal angle grid (total 1800x3600 grids over the globe). Due to the relatively large uncertainties associated with surface reflectance over water glint area and land surface as well as limited AVHRR retrieval channels, the current algorithm only performs retrieval over none-glint water surface (specifically at the anti-solar side of the orbit and viewing angle is larger than 40 degree away from the specular ray). The final CDR AOT products include daily and monthly products" ;
    dcat:distribution [ a dcat:Distribution ;
            dcat:accessURL <s3://data-c6c22a2e42294c11b52ee7f0c792c071/noaa-cdr-aerosol-optical-thickness-pds/daily/zarr_reference_final.json> ;
            dcat:mediaType "application/zarr" ] ;
    dcat:endDate "2022-12-31T23:59:59+00:00"^^xsd:dateTime ;
    dcat:startDate "1982-01-01T00:00:00+00:00"^^xsd:dateTime ;
    schema:contentUrl <s3://data-c6c22a2e42294c11b52ee7f0c792c071/noaa-cdr-aerosol-optical-thickness-pds/daily/zarr_reference_final.json> ;
    schema:description "The product is the aerosol optical thickness (AOT) at 0.65 micron, which is retrieved from NOAA PATMOS-x level-2B orbital radinace and cloud CDR products. The retrieval is performed for selected spatial(0.1 by 0.1 degree) and temporal (1 time per day per satellite) resolution in cloud free condition during daytime. The final product is daily avergaed from all satellite retrivals and in a 0.1 by 0.1 degree equal angle grid (total 1800x3600 grids over the globe). Due to the relatively large uncertainties associated with surface reflectance over water glint area and land surface as well as limited AVHRR retrieval channels, the current algorithm only performs retrieval over none-glint water surface (specifically at the anti-solar side of the orbit and viewing angle is larger than 40 degree away from the specular ray). The final CDR AOT products include daily and monthly products" ;
    schema:isAccessibleForFree true ;
    schema:keywords "" ;
    schema:name "Daily AVHRR Aerosol Optical Thickness over Global Oceans, Version 4.0" ;
    schema:variableMeasured :atmosphere_optical_thickness_due_to_ambient_aerosol_noaa-cdr-aerosol-optical-thickness-pds_daily,
        :latitude,
        :longitude,
        :time ;
    schema:version "2" .

